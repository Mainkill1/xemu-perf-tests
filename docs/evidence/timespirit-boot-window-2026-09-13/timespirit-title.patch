+/* A non-incrementing ELEMENT16 packet consumes two ordered mesh indices per
+   word. Keep each pbkit block below its 128-DWORD recommended size. */
+static void draw_indexed_batched(const uint8_t *indices, uint32_t count)
+{
+    uint32_t start = 0;
+    uint32_t *p = pb_begin();
+    p = pb_push1(p, NV097_SET_BEGIN_END,
+                 NV097_SET_BEGIN_END_OP_TRIANGLES);
+    pb_end(p);
+    while (start + 1 < count) {
+        uint32_t batch = count - start;
+        if (batch > 240) batch = 240;
+        batch &= ~1u;
+        p = pb_begin();
+        pb_push(p, 0x40000000 | NV097_ARRAY_ELEMENT16, batch / 2);
+        ++p;
+        memcpy(p, indices + (size_t)start * 2, (size_t)batch * 2);
+        p += batch / 2;
+        pb_end(p);
+        start += batch;
+    }
+    if (start < count) {
+        p = pb_begin();
+        p = pb_push1(p, 0x40000000 | NV097_ARRAY_ELEMENT32,
+                     read_u16_le(indices + (size_t)start * 2));
+        pb_end(p);
+    }
+    p = pb_begin();
+    p = pb_push1(p, NV097_SET_BEGIN_END, NV097_SET_BEGIN_END_OP_END);
+    pb_end(p);
+}
