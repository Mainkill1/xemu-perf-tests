diff --git a/hw/xbox/nv2a/pgraph/pgraph.c b/hw/xbox/nv2a/pgraph/pgraph.c
index 513768ed59..0fdb986995 100644
--- a/hw/xbox/nv2a/pgraph/pgraph.c
+++ b/hw/xbox/nv2a/pgraph/pgraph.c
@@ -3411,6 +3411,9 @@ void pgraph_write_zpass_pixel_cnt_report(NV2AState *d, hwaddr dma_report,
     stl_le_p((uint32_t *)&report_data[8], result);
     stl_le_p((uint32_t *)&report_data[12], done);
 
+    trace_nv2a_pgraph_report_written(
+        (uint32_t)(report_data - d->vram_ptr), result);
+
     NV2A_DPRINTF("Report result %d @%" HWADDR_PRIx, result, offset);
 }
 
diff --git a/hw/xbox/nv2a/pgraph/vk/reports.c b/hw/xbox/nv2a/pgraph/vk/reports.c
index a3ef934789..fff2f68884 100644
--- a/hw/xbox/nv2a/pgraph/vk/reports.c
+++ b/hw/xbox/nv2a/pgraph/vk/reports.c
@@ -19,6 +19,15 @@
 
 #include "renderer.h"
 
+/* Diagnostic trace-only address: nv_dma_map() uses the same 27-bit base. */
+static uint32_t report_trace_vram_addr(NV2AState *d, hwaddr dma_obj,
+                                       uint32_t parameter)
+{
+    DMAObject dma = nv_dma_load(d, dma_obj);
+    return (dma.address & 0x07FFFFFF) +
+           GET_MASK(parameter, NV097_GET_REPORT_OFFSET);
+}
+
 void pgraph_vk_init_reports(PGRAPHState *pg)
 {
     PGRAPHVkState *r = pg->vk_renderer_state;
@@ -81,6 +90,12 @@ void pgraph_vk_get_report(NV2AState *d, uint32_t parameter)
     report->query_count = r->num_queries_in_flight;
     QSIMPLEQ_INSERT_TAIL(&r->report_queue, report, entry);
 
+    trace_nv2a_pgraph_vk_report_queued(
+        (uint32_t)report->dma_report,
+        GET_MASK(parameter, NV097_GET_REPORT_OFFSET),
+        report_trace_vram_addr(d, report->dma_report, parameter),
+        report->query_count);
+
     r->new_query_needed = true;
 }
 
@@ -156,6 +171,16 @@ void pgraph_vk_process_pending_reports(NV2AState *d)
 
     if (*dma_get == *dma_put && r->in_command_buffer &&
         !QSIMPLEQ_EMPTY(&r->report_queue)) {
+        QueryReport *pending;
+        QSIMPLEQ_FOREACH(pending, &r->report_queue, entry) {
+            if (!pending->clear) {
+                trace_nv2a_pgraph_vk_report_stall(
+                    report_trace_vram_addr(d, pending->dma_report,
+                                           pending->parameter),
+                    pending->query_count);
+                break;
+            }
+        }
         pgraph_vk_finish(pg, VK_FINISH_REASON_STALLED);
     }
 }
