+def calculate_improvement_percent(
+    baseline: float, candidate: float, raw_positive_is: str
+) -> float | None:
+    if raw_positive_is not in ("+good", "+bad", "N/A"):
+        raise ValueError(f"invalid raw-positive marker: {raw_positive_is}")
+    if raw_positive_is == "N/A" or baseline == 0:
+        return None
+    raw_change = (candidate / baseline) - 1.0
+    improvement = raw_change if raw_positive_is == "+good" else -raw_change
+    return improvement * 100.0
+
+
+def improvement_interval_from_ratio(
+    ratio_lower: float, ratio_upper: float, raw_positive_is: str
+) -> dict[str, float] | None:
+    if raw_positive_is not in ("+good", "+bad", "N/A"):
+        raise ValueError(f"invalid raw-positive marker: {raw_positive_is}")
+    if raw_positive_is == "N/A":
+        return None
+    if raw_positive_is == "+good":
+        lower = (ratio_lower - 1.0) * 100.0
+        upper = (ratio_upper - 1.0) * 100.0
+    else:
+        lower = (1.0 - ratio_upper) * 100.0
+        upper = (1.0 - ratio_lower) * 100.0
+    return {"lower": lower, "upper": upper}
+
+
+def format_improvement(value: float | None) -> str:
+    if value is None:
+        return "N/A"
+    if abs(value) < 0.005:
+        return "0.00%"
+    return f"{value:+.2f}%"
+
+
